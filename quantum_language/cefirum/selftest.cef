# Cefirum v0.1 self-test
fun add(a, b) { return a + b }
fun fact(n) { if n <= 1 { return 1 } return n * fact(n - 1) }
print "add(2,3) =", add(2, 3), "(expect 5)"
print "fact(20) =", fact(20), "(expect 2432902008176640000)"
x = arr(5)
for i = 0 to 4 { x[i] = i * i }
s = 0
for i = 0 to 4 { s = s + x[i] }
print "sum of squares:", s, "(expect 30)"
assert s == 30, "square sum"
b = bitxor(5, 3)
assert b == 6, "bitxor(5,3)==6"
print "bit ops:", bitand(12, 10), bitor(12, 10), popcount(255)
print "qpu bell:", qpu_run("bell", 400)
print "SELF-TEST PASS"
