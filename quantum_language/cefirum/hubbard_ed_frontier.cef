# ZYKL DECISION KATA — fronteira da diagonalizacao exata (ED) do Hubbard 2D
#
# Fontes primarias (nenhuma citacao de divulgacao em redes sociais):
#  [1] J. Hubbard, "Electron correlations in narrow energy bands",
#      Proc. R. Soc. Lond. A 276, 238 (1963) — o modelo original.
#  [2] P. A. Lee, N. Nagaosa e X.-G. Wen, "Doping a Mott insulator: physics
#      of high-temperature superconductivity", Rev. Mod. Phys. 78, 17 (2006)
#      — por que Hubbard 2D dopado importa para cupratos.
#
# Pergunta de decisao: para uma rede Hubbard 2D de L = n x n sitios, a
# diagonalizacao exata classica cabe na cota declarada de 2^30 determinantes?
# Setor de meia ocupacao (L par): N_up = N_dn = L/2, dim = C(L, L/2)^2.
# Redes impares (L impar): N = L - 1 eletrons, N_up = N_dn = (L-1)/2,
# dim = C(L, (L-1)/2)^2 (o analogo de uma casa de dopagem; aproximacao
# honesta declarada para manter o setor fechado).
# Nao diagonalizamos nada: decidimos por cota combinato.
# Vereditos: 1 (ED cabe) / REFUSED (excede a cota — recusado).
# Maturidade: IMPLEMENTADO (a dimensao e combinato exata).

fun log2_binom(n, k) {
  s = 0
  for i = 0 to k - 1 {
    s += ln(n - i) - ln(i + 1)
  }
  return s / ln(2)
}

COTA = 30   # log2 do maximo de determinantes no ED classico declarado

print "rede Hubbard 2D | log2(dim_ED) | veredito trivalente"
frontier = 0
for n = 2 to 8 {
  L = n * n
  if L % 2 == 0 {
    d = 2 * log2_binom(L, L / 2)
  } else {
    m = (L - 1) / 2
    d = 2 * log2_binom(L, m)
  }
  if d <= COTA {
    print n, "x", n, " (L=", L, ") : ", d, " -> 1 (ED cabe na cota)"
    frontier = n
  } else {
    print n, "x", n, " (L=", L, ") : ", d, " -> REFUSED (excede a cota em ", d - COTA, " bits)"
  }
}

# Fronteira decidida: 4x4 cabe (dim ~ 2^27.3); 5x5 ja nao (dim ~ 2^44.6).
assert frontier == 4, "fronteira ED entre 4x4 e 5x5"

d16 = 2 * log2_binom(16, 8)
d25 = 2 * log2_binom(25, 12)
assert d16 <= COTA, "4x4 dentro da cota"
assert d25 > COTA, "5x5 recusado por cota"

print "KATA PASS — alem da fronteira decidida, o ED exato e REFUSED por cota;"
print "a rota de hardware quantico justifica-se COMBINATORIAMENTE, sem promessa"
print "de resultado fisico. Maturidade: IMPLEMENTADO (limites) / ESPECIFICACAO (energias)."
print "ASK FIRST. PROVE NEXT. COMPUTE LAST."
