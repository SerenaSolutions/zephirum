# ZYKL DECISION KATA — cotas do defeito NV em diamante (eliminacao por cotas)
#
# Fontes primarias (nenhuma citacao de divulgacao em redes sociais):
#  [1] J. M. P. Martirez, "Optical properties of a diamond NV color center
#      from capped embedded multiconfigurational correlated wavefunction
#      theory", npj Computational Materials 12, 113 (2026). arXiv:2505.01250.
#      DOI 10.1038/s41524-026-01987-1. (capped-DFET + NEVPT2; um cluster
#      contendo o defeito e vizinhos mais proximos basta — da ordem de 40
#      atomos.)
#  [2] Princeton Plasma Physics Laboratory, comunicado institucional de
#      13/10/2026 — quimica quantica aplicada a materiais de qubit em
#      diamante.
#
# Pergunta de decisao: SEM construir nenhuma funcao de onda, quais caminhos
# de calculo do defeito NV cabem na cota declarada de 2^40 determinantes?
# Vereditos trivalentes: 1 (dentro da cota) / REFUSED (recusado: excede a
# cota). Maturidade: IMPLEMENTADO (as cotas sao computadas, nao estimadas);
# a fisica dos defeitos segue EXPERIMENTAL na literatura primaria [1].
# Estado: ESPECIFICACAO->IMPLEMENTADO no ciclo ZEPHIRUM; NAO alegamos
# nenhuma energia de excitacao — so limites combinato.

fun log2_binom(n, k) {
  # log2 C(n,k) por soma de logaritmos: exato no limite de precisao dupla,
  # sem combinacao inteira necessaria para uma DECISAO por cota.
  s = 0
  for i = 0 to k - 1 {
    s += ln(n - i) - ln(i + 1)
  }
  return s / ln(2)
}

COTA = 40   # log2 do maximo de determinantes FCI no orcamento declarado

# Caminho 1: cristal de diamante inteiro (materia em vez de ponto).
M = 100000  # atomos de carbono numa supercelula macroscopica
log2_full = log2_binom(4 * M, 2 * M)

# Caminho 2: FCI bruto do cluster de 30 atomos (sem embedding).
log2_cluster = log2_binom(4 * 30, 2 * 30)

# Caminho 3: espaco ativo multiconfiguracional do defeito (10 eletrons em
# 10 orbitais ativos), no espirito do embedding de [1].
log2_active = log2_binom(20, 10)

print "cota declarada: 2^", COTA, "determinantes"
print "cristal inteiro (4x10^5 orbitais) : log2(dim) =", log2_full
print "FCI bruto, cluster de 30 atomos   : log2(dim) =", log2_cluster
print "espaco ativo 10e/10o (embedding)  : log2(dim) =", log2_active

if log2_full > COTA {
  print "VEREDITO  cristal inteiro : REFUSED (excede a cota em ", log2_full - COTA, " bits)"
}
if log2_cluster > COTA {
  print "VEREDITO  FCI bruto       : REFUSED (excede a cota em ", log2_cluster - COTA, " bits)"
}
if log2_active <= COTA {
  print "VEREDITO  espaco ativo   : 1 (dentro da cota — pode computar)"
}

assert log2_full > 9000, "cristal inteiro recusado por cota"
assert log2_cluster > COTA, "FCI bruto do cluster recusado por cota"
assert log2_active <= COTA, "espaco ativo dentro da cota"

print "KATA PASS — eliminacao por cotas sem executar nenhuma diagonalizacao"
print "A fronteira foi DECIDIDA antes de qualquer COMPUTE."
print "ASK FIRST. PROVE NEXT. COMPUTE LAST."
